{
  "name": "dylando-ultimate-credit-repair-suite",
  "productName": "Dylando Ultimate Credit Repair Suite",
  "description": "Dylandos Ultimate Credit Repair Suite for dispute workflow automation and credit profile management.",
  "author": "DylandOs",
  "private": true,
  "version": "5.6.3",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:electron": "cross-env BUILD_TARGET=electron vite build",
    "preview": "vite preview",
    "clean": "rimraf dist release",
    "lint": "tsc --noEmit",
    "test:upgrade": "tsx scripts/final-upgrade-regression.ts",
    "test:orchestrator": "tsx scripts/orchestrator-regression.ts",
    "test:merge": "tsx scripts/merge-golden.ts",
    "test:apex": "tsx scripts/apex-tests.ts",
    "test:letters": "tsx scripts/letter-engine-regression.ts",
    "test:all": "npm run test:upgrade && npm run test:orchestrator && npm run test:merge && npm run test:apex && npm run test:letters",
    "electron:dev": "concurrently --kill-others \"vite --port=5173\" \"cross-env ELECTRON_IS_DEV=true VITE_DEV_SERVER_URL=http://localhost:5173 electron electron/main.cjs\"",
    "electron:build": "npm run build:electron && electron-builder --config electron-builder.json",
    "electron:debug": "npm run build:electron && cross-env ELECTRON_IS_DEV=true electron electron/main.cjs",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@google/genai": "^1.29.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "adm-zip": "^0.5.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.12",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^2.5.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^15.0.0",
    "react-markdown": "^10.1.0",
    "react-qr-code": "^2.0.18",
    "string-similarity": "^4.0.4",
    "tailwind-merge": "^3.5.0",
    "uuid": "^13.0.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/string-similarity": "^4.0.2",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1",
    "rimraf": "^6.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
